# Copia este archivo como deploy/.env y ajusta lo que necesites.
# docker compose lee automáticamente deploy/.env.

# --- PostgreSQL ---
PG_DB=retail_bi
PG_USER=retail_etl
PG_PASSWORD=retail_demo

# Puerto del host para conectarse con Power BI / psql (5433 evita chocar con un Postgres local).
PG_PORT_EXTERNO=5433

# --- Panel y web ---
PANEL_PORT=8000
WEB_PORT=8080
# URL que verá el botón "Abrir página web". En un servidor remoto usa su dominio o IP.
WEB_URL=http://localhost:8080

# --- Kaggle (solo para el modo "completo") ---
# Se sacan de Kaggle > Settings > API > Create New Token.
# Puedes dejar esto vacío y usar el modo "caché local".
KAGGLE_USERNAME=
KAGGLE_KEY=
